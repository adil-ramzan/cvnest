{
  "name": "resume-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:unit": "node -e \"require('fs').rmSync('.test-build',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --require ./tests/unit/register.cjs --test \".test-build/tests/unit/*.test.js\"",
    "test:e2e": "node tests/e2e/run.mjs",
    "verify": "npm run typecheck && npm run test:unit && npm run build",
    "lint": "eslint ."
  },
  "dependencies": {
    "lucide-react": "^1.64.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "puppeteer-core": "24.43.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
